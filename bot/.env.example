# Bu faylni .env nomi bilan nusxalang va to'ldiring. .env ni hech qachon GitHub'ga yuklamang!

# @BotFather bergan token
BOT_TOKEN=

# AI: claude yoki gemini
LLM_PROVIDER=claude

# Claude: https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max (yuqorisi — sifatliroq, lekin qimmatroq)
CLAUDE_EFFORT=high
CLAUDE_FALLBACKS=1

# Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Sizning Telegram ID ingiz (@userinfobot dan bilib olasiz). Bir nechta bo'lsa vergul bilan.
OWNER_IDS=
# Sizning Notion integratsiya tokeningiz (ntn_...) — faqat OWNER_IDS uchun ishlaydi.
# Boshqa foydalanuvchilar botning o'zida o'z tokenini ulaydi.
NOTION_TOKEN=

# Bo'sh — bot hamma uchun ochiq. To'ldirilsa — faqat shu ID lar foydalana oladi.
ALLOWED_USER_IDS=

DEFAULT_TZ=Asia/Tashkent
ANALYTICS_REMINDER_HOURS=24
MAX_SCENARIOS_PER_DAY=15
DB_PATH=data/bot.db
